<!DOCTYPE html>
<%= stylesheet_link_tag 'application', :media => "all" %>
<%= javascript_importmap_tags %>
<header class="site-header">
  <div class="header-inner">
    <!-- 左：ゴルフボールロゴ -->
    <div class="header-logo">
      <%= image_tag "ごるｈ.avif", alt: "Golf Ball Logo" %>
    </div>

    <!-- 中央：サイトタイトル -->
    <h1 class="header-title">Golf Club Select</h1>
      <head>
        <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@700;900&display=swap" rel="stylesheet">
      </head>
    <!-- 右：ナビゲーション -->
    <nav class="nav-menu">
      <ul>
        <li><%= link_to "ホーム", tweets_path %></li>
        <li><%= link_to "クラブ一覧", tweets_path %></li>
      </ul>
    </nav>
  </div>
</header>

    <main class="main-content">
      <%= yield %>
    </main>

    <footer class="site-footer">
      <p>© 2025 Golf Club Select</p>
    </footer>
  </body>
</html>
