<!DOCTYPE html>
<html>
  <head>
    <title>Golf Club Select</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
    <header class="site-header">
      <div class="header-inner">
        <h1 class="logo">Golf Club Select</h1>
        <nav class="nav-menu">
          <ul>
            <li><%= link_to "ホーム", tweets_path %></li>
            <li><%= link_to "クラブ一覧", tweets_path %></li>
            <li><%= link_to "検索ページ", search_path %></li>

            </ul>
        </nav>
      </div>
    </header>

    <main class="main-content">
      <%= yield %>
    </main>

    <footer class="site-footer">
      <p>© 2025 Golf Club Select</p>
    </footer>
  </body>
</html>
